# Habit Garden - Git Ignore File
#
# This file tells Git which files to ignore when committing.
# Keep sensitive files and build artifacts out of version control.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/

# Django
*.log
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
staticfiles/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
*.tmp

# Environment variables
.env
.env.local

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
